{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "core/src/**/*.ts",
    "providers/**/*.ts",
    "memory/src/**/*.ts",
    "execution/src/**/*.ts",
    "tools/src/**/*.ts",
    "cloudflare/worker/**/*.ts"
  ]
}
